# ---------- Backend (apps/web) ----------
# Copy to apps/web/.env.local for local dev. Never commit real values.
# Neon pooled connection string. Leave unset locally to use an embedded PGlite database.
DATABASE_URL=
# Public URL of the backend. Agents call this from Maritime's cloud, so it must be reachable from the internet.
APP_BASE_URL=https://your-helm-backend.example.com
# Server-side only. Never expose to the browser.
MARITIME_API_KEY=mk_xxx
MARITIME_API_URL=https://api.maritime.sh
# Upload key (from `maritime agents upload-source agent/`) or GitHub repo used when provisioning student agents.
MARITIME_AGENT_UPLOAD_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
# Used to sign/verify agent tokens.
AGENT_EVENT_SECRET=change-me-32-bytes-random
AUTH_SECRET=change-me
DEMO_MODE=true
ELEVENLABS_API_KEY=

# ---------- Agent container (injected per student as Maritime env) ----------
# HELM_BACKEND_URL=https://your-helm-backend.example.com
# HELM_AGENT_TOKEN=<random 32 bytes, per agent; backend stores only the hash>
# HELM_STUDENT_ID=<users.id>
# GEMINI_API_KEY=
# PORTAL_URL=https://your-helm-backend.example.com/mock-portal
# PORTAL_USERNAME=
# PORTAL_PASSWORD=
# TZ=America/Vancouver
